# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars

project = "berqiqch-portfolio"
region  = "eu-central-1"

# --- contact form ---------------------------------------------------------

mail_to   = "yassine.berqiqch@gmail.com"
mail_from = "yassine.berqiqch@gmail.com"

# Keep false until AWS grants SES production access: the sandbox refuses to
# deliver to unverified recipients, which is every visitor.
auto_reply = false

# Verify the domain so mail is DKIM-signed instead of failing DMARC alignment.
# Terraform outputs the three CNAMEs to create (terraform output ses_dkim_records).
ses_domain = "berqiqch.de"

# Leave mail_from on the Gmail identity until the line above reports verified.
# SES rejects sends from an unverified identity, so switching early breaks the
# form. Afterwards: mail_from = "noreply@berqiqch.de"

# --- CI/CD ----------------------------------------------------------------

# Set once the repository exists to create the OIDC deploy role.
github_repository = "aperskii/berqiqch-portfolio"
github_branch     = "main"

# Some accounts issue OIDC subject claims with immutable numeric ids embedded
# (repo:owner@<id>/name@<id>:ref:...) rather than the documented name form. This
# one does, and a trust policy matching only names is denied. Get the ids with:
#   curl -s https://api.github.com/repos/<owner>/<name> | jq '.owner.id, .id'
# Leave empty if your account issues the name form. See DEPLOY.md section 6.
github_owner_id      = "101721381"
github_repository_id = "1332172797"

# This account already has a GitHub OIDC provider, and AWS allows only one per
# issuer URL, so reference it rather than creating a second.
create_github_oidc_provider = false

# --- custom domain --------------------------------------------------------

# DNS stays at checkdomain (ns.checkdomain.de); nothing here manages records.
# www first: it becomes the canonical origin and matches index.html's canonical.
domain_names = ["www.berqiqch.de", "berqiqch.de"]

# Two-stage on purpose. False requests the certificate only, so its validation
# CNAME can be read and created by hand. Flip to true once ACM reports ISSUED —
# CloudFront rejects a PENDING_VALIDATION certificate. See DEPLOY.md section 7.
attach_custom_domain = false
